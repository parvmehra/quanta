# Copy to backend/.env and fill in. Only JWT_SECRET is required to start.

# ── Required ───────────────────────────────────────────────────────
PORT=3001
# Min 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Optional ───────────────────────────────────────────────────────
# Extra allowed browser origins (comma-separated), e.g. your deployed frontend.
# localhost is always allowed in development.
CORS_ORIGIN=
APP_BASE_URL=http://localhost:5173

# MongoDB: required for trading, wallet and portfolio (Atlas free tier works). Include the database name, e.g. .../quanta?retryWrites=true&w=majority
MONGO_DB_URI=

# Market data fallbacks (Yahoo Finance needs no key)
FINNHUB_API_KEY=

# AI Advisor (works without a key using the built-in rule-based fallback)
GEMINI_API_KEY=

# Email (Gmail app password OR generic SMTP). Without these, emails are simulated.
GMAIL_USER=
GMAIL_APP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# SMS (Twilio). Without these, SMS is simulated.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Google sign-in token verification (Firebase Admin)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
